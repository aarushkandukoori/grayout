<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Electron's MAS zip ships Contents/Library/LoginItems/<App> Login Helper.app.
     Grayout does not use it (start at login is SMAppService.mainApp), but if
     launchd ever starts it, it runs on its own, so it cannot use inherit. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
</dict>
</plist>
